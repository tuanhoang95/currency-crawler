 the mission is clear, and the movement is just getting started. It’s time to make memes great again.","zh":"","zh-tw":"","de":"","fr":"","es":"","ja":"","id":"","ru":"","ko":"","ar":"","th":"","vi":"","it":"","pl":"","tr":"","hu":"","nl":"","ro":"","sv":"","cs":"","da":"","el":"","hi":"","no":"","sk":"","uk":"","he":"","fi":"","bg":"","hr":"","lt":"","sl":"","pt":""},"links":{"homepage":["https://www.makememesgreatagain.xyz/"],"whitepaper":"","blockchain_site":["https://solscan.io/token/87B6mb9KBjaF5NHrB3H33f7grdUHi4oWmMErjhZ5bonk","https://intel.arkm.com/explorer/token/","https://intel.arkm.com/explorer/token/make-memes-great-again"],"official_forum_url":["https://x.com/i/communities/1968699949123543418"],"chat_url":[],"announcement_url":[],"snapshot_url":null,"twitter_screen_name":"MMGAcoin__","facebook_username":"","bitcointalk_thread_identifier":null,"telegram_channel_identifier":"","subreddit_url":null,"repos_url":{"github":[],"bitbucket":[]}},"image":{"thumb":"https://coin-images.coingecko.com/coins/images/71352/thumb/O1sWAb45_400x400.jpg?1767496059","small":"https://coin-images.coingecko.com/coins/images/71352/small/O1sWAb45_400x400.jpg?1767496059","large":"https://coin-images.coingecko.com/coins/images/71352/large/O1sWAb45_400x400.jpg?1767496059"},"country_origin":"","genesis_date":null,"contract_address":"87B6mb9KBjaF5NHrB3H33f7grdUHi4oWmMErjhZ5bonk","sentiment_votes_up_percentage":100.0,"sentiment_votes_down_percentage":0.0,"watchlist_portfolio_users":38,"market_cap_rank":3592,"market_data":{"current_price":{"aed":0.00445886,"ars":1.8,"aud":0.00181934,"bch":1.87e-06,"bdt":0.148788,"bhd":0.00045877,"bmd":0.00121412,"bnb":1.35e-06,"brl":0.006586,"btc":1.3067e-08,"cad":0.00167154,"chf":0.00096497,"clp":1.096,"cny":0.00847809,"czk":0.02511144,"dkk":0.00776727,"dot":0.00056386,"eos":0.00678738,"eth":3.81058e-07,"eur":0.0010398,"gbp":0.00090484,"gel":0.00326599,"hkd":0.00945701,"huf":0.398591,"idr":20.33,"ils":0.00386883,"inr":0.109559,"jpy":0.190851,"krw":1.76