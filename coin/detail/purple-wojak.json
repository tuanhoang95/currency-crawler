-chain wallet activity. The project emphasizes transparency, open access, and organic community development without making claims regarding financial performance, investment returns, or future outcomes.","zh":"","zh-tw":"","de":"","fr":"","es":"","ja":"","id":"","ru":"","ko":"","ar":"","th":"","vi":"","it":"","pl":"","tr":"","hu":"","nl":"","ro":"","sv":"","cs":"","da":"","el":"","hi":"","no":"","sk":"","uk":"","he":"","fi":"","bg":"","hr":"","lt":"","sl":"","pt":""},"links":{"homepage":["https://www.purplewojak.com/"],"whitepaper":"https://www.purplewojak.com/_files/ugd/154f8b_8ca4e3025fb64d10902f72c51acba6d5.pdf","blockchain_site":["https://solscan.io/token/BBG3vpXVCm2uPBD7LUr7yfP9XUXVNJRHMtiMG7q4pump","https://intel.arkm.com/explorer/token/","https://intel.arkm.com/explorer/token/purple-wojak"],"official_forum_url":["https://www.tiktok.com/@purplewojak?_r=1\u0026_t=ZT-92NxScouCyr"],"chat_url":[],"announcement_url":[],"snapshot_url":null,"twitter_screen_name":"purkonsol","facebook_username":null,"bitcointalk_thread_identifier":null,"telegram_channel_identifier":"PurpleWojak1","subreddit_url":null,"repos_url":{"github":[],"bitbucket":[]}},"image":{"thumb":"https://coin-images.coingecko.com/coins/images/71360/thumb/CMC_PFP.png?1767589895","small":"https://coin-images.coingecko.com/coins/images/71360/small/CMC_PFP.png?1767589895","large":"https://coin-images.coingecko.com/coins/images/71360/large/CMC_PFP.png?1767589895"},"country_origin":null,"genesis_date":null,"contract_address":"BBG3vpXVCm2uPBD7LUr7yfP9XUXVNJRHMtiMG7q4pump","sentiment_votes_up_percentage":90.91,"sentiment_votes_down_percentage":9.09,"watchlist_portfolio_users":34,"market_cap_rank":3100,"market_data":{"current_price":{"aed":0.0071646,"ars":2.87,"aud":0.00290108,"bch":3.02e-06,"bdt":0.238546,"bhd":0.00073538,"bmd":0.00195088,"bnb":2.15e-06,"brl":0.0105525,"btc":2.081e-08,"cad":0.00268463,"chf":0.00154299,"clp":1.76,"cny":0.01361987,"czk":0.0402259,"dkk":0.01241726,"dot":0.00088188,"eos":0.01043928,"